# Commerce-Students — environment variables (for future backend)
# Never commit real secrets. This file is an example.

# AI backend (if you add a serverless proxy)
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# Database (Supabase / Firebase / Postgres)
# DATABASE_URL=postgresql://user:pass@host:5432/db
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Auth
# AUTH_SECRET=change-me
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Site
# NEXT_PUBLIC_SITE_URL=https://commerce-students.github.io
